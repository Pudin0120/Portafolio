---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project)=>({params:{slug:project.slug},props:{project}})); }
const {project}=Astro.props;
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isRepositorySearch = project.repositoryLabel.toLowerCase().includes('search');
---
<BaseLayout title={`${project.title} | Joseff Laverde`} description={project.summary}>
<section class="section-wrap detail-page"><a class="back-link" href={`${base}proyectos/`}>← Back to projects</a><p class="eyebrow">{project.categoryLabel} / {project.classification}</p><h1>{project.title}</h1><p class="detail-lead">{project.summary}</p>
<div class="detail-layout"><article class="detail-content"><h2>Project overview</h2><p>{project.description}</p><h2>Documented technical highlights</h2><ul class="detail-highlights">{project.highlights.map((item)=><li>{item}</li>)}</ul><h2>Technology stack</h2><div class="tag-row detail-tags">{project.stack.map((item)=><span>{item}</span>)}</div><div class="detail-disclaimer"><strong>Scope note:</strong> This page summarizes the project information and repository structure reviewed for this portfolio. It does not imply a public production deployment or that every feature has been independently tested at runtime.</div></article>
<aside class="detail-sidebar"><span class="sidebar-label">{isRepositorySearch ? 'REPOSITORY SEARCH' : 'SOURCE REPOSITORY'}</span><h3>{project.repositoryLabel}</h3><p>{isRepositorySearch ? 'The project was not found as a standalone folder in this repository. Use the GitHub search link to locate its source.' : 'Open the original source code and review the available setup documentation.'}</p><a class="button button-primary button-full" href={project.repository} target="_blank" rel="noreferrer">{isRepositorySearch ? 'Find repository ↗' : 'Open source code ↗'}</a><div class="sidebar-divider"></div><span class="sidebar-label">PROJECT TYPE</span><p>{project.classification}</p></aside></div></section>
</BaseLayout>