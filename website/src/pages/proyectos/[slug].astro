---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project)=>({params:{slug:project.slug},props:{project}})); }
const {project}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${project.title} | Joseff Laverde`} description={project.summary}>
<section class="section-wrap detail-page"><a class="back-link" href={`${base}proyectos/`}>← Volver a proyectos</a><p class="eyebrow">{project.categoryLabel} / {project.classification}</p><h1>{project.title}</h1><p class="detail-lead">{project.summary}</p>
<div class="detail-layout"><article class="detail-content"><h2>Descripción</h2><p>{project.description}</p><h2>Aspectos técnicos documentados</h2><ul class="detail-highlights">{project.highlights.map((item)=><li>{item}</li>)}</ul><h2>Tecnologías</h2><div class="tag-row detail-tags">{project.stack.map((item)=><span>{item}</span>)}</div><div class="detail-disclaimer"><strong>Transparencia:</strong> esta ficha resume la documentación y estructura revisadas en el repositorio. No implica que exista un despliegue público o que todas las funcionalidades hayan sido auditadas en ejecución.</div></article>
<aside class="detail-sidebar"><span class="sidebar-label">REPOSITORIO</span><h3>{project.repositoryLabel}</h3><p>Consulta el código fuente y la documentación de instalación.</p><a class="button button-primary button-full" href={project.repository} target="_blank" rel="noreferrer">Abrir código ↗</a><div class="sidebar-divider"></div><span class="sidebar-label">CLASIFICACIÓN</span><p>{project.classification}</p></aside></div></section>
</BaseLayout>