---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
const filters = [{id:'all',label:'Todos'},{id:'fullstack',label:'Full Stack'},{id:'backend',label:'Backend'},{id:'desktop',label:'Escritorio'}];
---
<BaseLayout title="Proyectos | Joseff Laverde" description="Proyectos de desarrollo backend, full stack y aplicaciones de escritorio de Joseff Laverde.">
<section class="page-hero section-wrap"><p class="eyebrow">PORTAFOLIO / PROYECTOS</p><h1>Trabajo, decisiones <span class="text-gradient">y tecnología.</span></h1><p>Una selección de proyectos personales y académicos. Cada ficha explica el propósito, el stack documentado y dónde consultar el código.</p></section>
<section class="section-wrap projects-section">
<div class="project-toolbar"><div class="filter-group" role="group" aria-label="Filtrar proyectos">{filters.map((filter,index)=><button class:list={['filter-button',{active:index===0}]} type="button" data-filter={filter.id} aria-pressed={index===0?'true':'false'}>{filter.label}</button>)}</div><label class="project-search"><span aria-hidden="true">⌕</span><input id="project-search" type="search" placeholder="Buscar tecnología o proyecto..." /></label></div>
<div class="project-grid" id="project-grid">{projects.map((project)=><article class="project-card" data-project-card data-category={project.category} data-search={`${project.title} ${project.summary} ${project.stack.join(' ')}`.toLowerCase()}><div class="project-card-top"><span class="project-type">{project.categoryLabel}</span><span class="project-type project-type-muted">{project.classification}</span></div><div><h2><a href={`${base}proyectos/${project.slug}/`}>{project.title}</a></h2><p>{project.summary}</p></div><div class="tag-row">{project.stack.map((item)=><span>{item}</span>)}</div><div class="project-card-bottom"><a class="text-link" href={`${base}proyectos/${project.slug}/`}>Detalles ↗</a><a class="text-link" href={project.repository} target="_blank" rel="noreferrer">Código ↗</a></div></article>)}</div>
<p class="empty-state" id="projects-empty" hidden>No hay proyectos que coincidan con tu búsqueda.</p><p class="catalog-note">El catálogo general conserva más proyectos en GitHub. Esta vista prioriza trabajos con documentación técnica suficiente para explicarlos.</p>
</section></BaseLayout>