---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const filters = [{id:'all',label:'All projects'},{id:'fullstack',label:'Full Stack'},{id:'backend',label:'Backend'},{id:'desktop',label:'Desktop'}];
---
<BaseLayout title="Projects Archive | Joseff Laverde" description="The complete project archive by Joseff Laverde, including backend, full stack, desktop, healthcare, and academic software projects.">
<section class="page-hero section-wrap"><p class="eyebrow">PORTFOLIO / PROJECT ARCHIVE</p><h1>Projects, decisions, <span class="text-gradient">and technology.</span></h1><p>This is the complete archive of project folders: applications, games, algorithms, management systems, healthcare projects, and development tools. Search by name or technology, filter by category, and open each original project folder.</p></section>
<section class="section-wrap projects-section">
<div class="project-toolbar"><div class="filter-group" role="group" aria-label="Filter projects">{filters.map((filter,index)=><button class:list={['filter-button',{active:index===0}]} type="button" data-filter={filter.id} aria-pressed={index===0?'true':'false'}>{filter.label}</button>)}</div><label class="project-search"><span aria-hidden="true">⌕</span><input id="project-search" type="search" placeholder="Search by project or technology..." /></label></div>
<div class="project-grid" id="project-grid">{projects.map((project)=><article class="project-card" data-project-card data-category={project.category} data-search={`${project.title} ${project.summary} ${project.stack.join(' ')}`.toLowerCase()}><div class="project-card-top"><span class="project-type">{project.categoryLabel}</span><span class="project-type project-type-muted">{project.classification}</span></div><div><h2><a href={`${base}proyectos/${project.slug}/`}>{project.title}</a></h2><p>{project.summary}</p></div><div class="tag-row">{project.stack.map((item)=><span>{item}</span>)}</div><div class="project-card-bottom"><a class="text-link" href={`${base}proyectos/${project.slug}/`}>Project details ↗</a><a class="text-link" href={project.repository} target="_blank" rel="noreferrer">{project.repositoryLabel.includes('Search') ? 'Find project ↗' : 'Source code ↗'}</a></div></article>)}</div>
<p class="empty-state" id="projects-empty" hidden>No projects match your search.</p><p class="catalog-note">Showing {projects.length} project entries, including the folders detected under Projects/ and separately documented featured projects. When a folder does not contain enough technical documentation, its page says so and links to the original source instead of inventing features.</p>
</section></BaseLayout>