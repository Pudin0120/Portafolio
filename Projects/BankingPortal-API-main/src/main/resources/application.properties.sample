# Copy to application.properties for local use.
# Required secrets are supplied through environment variables.

server.port=${SERVER_PORT:8180}

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/bankingapp}
spring.datasource.username=${DB_USERNAME:bankinguser}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.generate-ddl=true
spring.jpa.show-sql=false
spring.jpa.hibernate.ddl-auto=update
spring.main.allow-circular-references=true

# Avoid exposing exception messages through the default error endpoint.
server.error.include-message=never

# CORS: comma-separated exact frontend origins.
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173}

# JWT signing secret: generate a long, random value and keep it outside source control.
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}
jwt.header=Authorization
jwt.prefix=Bearer

# Spring Mail
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Geolocation API
geo.api.url=${GEO_API_URL:https://api.findip.net/}
geo.api.key=${GEO_API_KEY}
