# Copy this file to the repository root as .env.
# Use local-only values. Never commit the resulting .env file.

MYSQL_ROOT_PASSWORD=replace-with-a-long-local-root-password
MYSQL_DATABASE=bankingapp
MYSQL_USER=bankinguser
MYSQL_PASSWORD=replace-with-a-different-local-user-password
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
