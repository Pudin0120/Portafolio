<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!-- Local Windows development using a trusted SQL Server connection. -->
  <add name="MIMS"
       providerName="System.Data.SqlClient"
       connectionString="Data Source=.;Initial Catalog=MIMS;Integrated Security=True;MultipleActiveResultSets=True" />
  <add name="PharmacySystem"
       providerName="System.Data.SqlClient"
       connectionString="Data Source=.;Initial Catalog=PharmacySystem;Integrated Security=True;MultipleActiveResultSets=True" />
</connectionStrings>
